  min_quantity_purchase integer [not null, default: 1]
  rations_quantity integer [not null, default: 1]
  cover_image varchar(2083) [null]
  secondary_image varchar(2083) [null]
  complementary_image varchar(2083) [null]
  image_gallery varchar(2083) [null]
  configuration char(36) [not null, ref: > ditaly_pasta.item_configuration.code]
  is_visible boolean [not null, default: 1]
  is_deleted boolean [null]
  is_confirmed boolean [null]
