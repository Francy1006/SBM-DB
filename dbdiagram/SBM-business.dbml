// START complementary tables
Table sbm_business.menu {
  id integer [pk, increment]
  menu varchar(50) [not null]
  description text [not null]
  franchise_only boolean [not null, default: 0]
}


Table sbm_business.item_group {
  id integer [pk, increment]
  group_name varchar(50) [not null]
  description text [not null]
  catalog_render boolean [not null, default: 1]
}

Table sbm_business.item_category {
  id integer [pk, increment]
  category varchar(50) [not null]
  description text [not null]
  catalog_render boolean [not null, default: 1]
}

Table sbm_business.item_type {
  id integer [pk, increment]
  type varchar(50) [not null]
  description text [not null]
}

Table sbm_business.package_type {
  id integer [pk, increment]
  type varchar(50) [not null]
  description text [not null]
}

Table sbm_business.transport_type {
  id integer [pk, increment]
  type varchar(50) [not null]
  description text [not null]
}

Table sbm_business.measure_unit {
  id integer [pk, increment]
  measure_unit varchar(50) [not null]
  description text [not null]
}

Table sbm_business.provider_type {
  id integer [pk, increment]
  type varchar(50) [not null]
  description text [not null]
}

Table sbm_business.instruction_type {
  id int [pk, increment]
  type varchar(50) [not null]
  description text [not null]
  is_deleted boolean [null]
  is_confirmed boolean [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  confirmed_at datetime [null]
  deleted_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  confirmed_by char(36) [null, ref: > sbm_business.user.code]
  updated_by char(36) [null, ref: > sbm_business.user.code]
  deleted_by char(36) [null, ref: > sbm_business.user.code]
}

Table sbm_business.permission_type {
  id integer [pk, increment]
  type varchar(50) [not null]
  description text [not null]
  is_deleted boolean [null]
  is_confirmed boolean [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  confirmed_at datetime [null]
  deleted_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  confirmed_by char(36) [null, ref: > sbm_business.user.code]
  updated_by char(36) [null, ref: > sbm_business.user.code]
  deleted_by char(36) [null, ref: > sbm_business.user.code]
}

Table sbm_business.bank_account_type {
  id integer [pk, increment]
  type varchar(255) [not null]
  description text [not null]
}

Table sbm_business.district {
  id integer [pk, increment]
  district varchar(255) [not null]
  region integer [not null, ref: > sbm_business.region.id]
  description text [not null]
}

Table sbm_business.region {
  id integer [pk, increment]
  region varchar(255) [not null]
  description text [not null]
}

Table sbm_business.fiscal_directive_type {
  id integer [pk, increment]
  type varchar(255) [not null]
  description text [not null]
}

Table sbm_business.user_type {
  id integer [pk, increment]
  type varchar(50) [not null]
  description text [not null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

// END complementary tables



