// START event tables

Table ditaly_pasta.event_type {
  id integer [pk, increment]
  code varchar(50) [not null, unique] // SESSION, PAYMENT, CONTRACT, DELIVERY, DEV_UPDATE, MARKETING, etc.
  name varchar(100) [not null]
  description text [null]
  is_active boolean [not null, default: 1]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.event {
  id integer [pk, increment]
  code char(36) [null, unique, note: 'UUID() REQUIRES TRIGGER']
  event_type integer [not null, ref: > ditaly_pasta.event_type.id]

  title varchar(150) [not null]
  description text [null]

  start_at datetime [null]
  end_at datetime [null]
  all_day boolean [not null, default: 0]

  internal_status varchar(50) [not null] // planned, in_progress, done, cancelled, error
  last_change_source varchar(50) [not null] // system, jira, calendar, manual

  jira_issue_key varchar(50) [null]
  jira_last_sync_at datetime [null]
  jira_last_sync_direction varchar(20) [null] // to_jira, from_jira

  calendar_event_id varchar(100) [null]
  calendar_last_sync_at datetime [null]
  calendar_last_sync_direction varchar(20) [null] // to_calendar, from_calendar

  is_active boolean [not null, default: 1]
  is_deleted boolean [null]

  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  updated_by char(36) [null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.event_content {
  id integer [pk, increment]
  event char(36) [not null, ref: > ditaly_pasta.event.code]
  content char(36) [not null, ref: > ditaly_pasta.content.code]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.event_campaign {
  id integer [pk, increment]
  event char(36) [not null, ref: > ditaly_pasta.event.code]
  campaign char(36) [not null, ref: > ditaly_pasta.marketing_campaign.code]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}

// END event tables



Table ditaly_pasta.client {
  id integer [pk, increment]
  code char(36) [not null, unique, note: 'UUID() REQUIRES TRIGGER']
  franchise char(36) [not null, ref: > sbm_business.franchise.code]
  detection_date date [not null]
  status integer [not null, ref: > sbm_business.status.id]
  platform integer [not null, ref: > ditaly_pasta.platform.id]
  exact_address varchar(255) [not null]
  district integer [not null, ref: > sbm_business.district.id]
  region integer [not null, ref: > sbm_business.region.id]
  same_address_detected boolean [not null, default: 0]
  estimated_type varchar(150) [null]
  operation_schedule varchar(150) [null]
  estimated_avg_ticket decimal(10,2) [null]
  has_visible_physical_store boolean [not null, default: 0]
  company_name varchar(255) [null]
  company_rut varchar(20) [null]
  owner_name varchar(255) [null]
  owner_position varchar(150) [null]
  linkedin_url varchar(255) [null]
  direct_phone varchar(50) [null]
  direct_email varchar(255) [null]
  contacted boolean [not null, default: 0]
  contact_date date [null]
  progress text [null]
  estimated_potential_volume decimal(14,2) [null]
  priority varchar(20) [null]
  observations text [null]
  is_active boolean [not null, default: 1]
  is_deleted boolean [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  deleted_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  updated_by char(36) [null, ref: > sbm_business.user.code]
  deleted_by char(36) [null, ref: > sbm_business.user.code]
  log text [not null, default: "init;"]
  version integer [not null, default: 1]
}


Table ditaly_pasta.client_brand {
  id integer [pk, increment]
  code char(36) [not null, unique, note: 'UUID() REQUIRES TRIGGER']

  client char(36) [not null, ref: > ditaly_pasta.client.code]
  brand_name varchar(150) [not null]

  is_active boolean [not null, default: 1]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]

  Indexes {
    (client, brand_name) [unique]
  }
}
