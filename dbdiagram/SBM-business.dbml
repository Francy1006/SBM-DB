  end_date datetime [not null]
  description text [null]
  is_active boolean [not null, default: 1]
  is_deleted boolean [null]
  is_confirmed boolean [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  updated_by char(36) [null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.campaign_profile {
  id integer [pk, increment]
  detail integer [not null, ref: > ditaly_pasta.campaign_detail.id]
  profile_name varchar(100) [not null]
  platform_account varchar(100) [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.campaign_movement_type {
  id integer [pk, increment]
  type varchar(50) [not null]
  description text [null]
  icon varchar(50) [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.campaign_movement {
  id integer [pk, increment] // PK
  code char(36) [null, unique, note: 'UUID() REQUIRES TRIGGER'] // Código UUID
  detail integer [not null, ref: > ditaly_pasta.campaign_detail.id] // Campaña / plataforma
  movement_type integer [not null, ref: > ditaly_pasta.campaign_movement_type.id] // Tipo de movimiento
  title varchar(255) [null] // Título interno
  post_text text [null] // Texto publicable (emojis)
  hashtags text [null] // Hashtags en texto plano
  url varchar(255) [null] // Link asociado
  description text [null] // Contexto interno
  notes text [null] // Notas para acciones no publicables
  jira_task varchar(50) [null] // ID Jira
  google_calendar_event_id varchar(50) [null] // ID Google Calendar
  average_kpi decimal(12,2) [null] // KPI promedio
  start_date datetime [not null] // Inicio
  end_date datetime [not null] // Fin
  is_active boolean [not null, default: 1] // Activo
  is_deleted boolean [null] // Eliminado lógico
  is_confirmed boolean [null] // Confirmado
  created_at datetime [default: `CURRENT_TIMESTAMP`] // Creación
  updated_at datetime [null] // Actualización
  created_by char(36) [not null, ref: > sbm_business.user.code] // Usuario creador
  updated_by char(36) [null, ref: > sbm_business.user.code] // Usuario editor
}


Table ditaly_pasta.campaign_metric_type {
  id integer [pk, increment]
  metric varchar(50) [not null]
  description text [null]
  platform integer [not null, ref: > ditaly_pasta.marketing_platform.id]
  code varchar(50) [not null, unique]
  icon varchar(50) [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.campaign_metric {
  id integer [pk, increment]
  detail integer [not null, ref: > ditaly_pasta.campaign_detail.id]
  type integer [not null, ref: > ditaly_pasta.campaign_metric_type.id]
  projected_value decimal(12,2) [not null, default: 0]
  actual_value decimal(12,2) [null]
  performance_pct decimal(5,2) [null]
  description text [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.campaign_movement_metric_impact {
  id integer [pk, increment]
  movement integer [not null, ref: > ditaly_pasta.campaign_movement.id]
  metric integer [not null, ref: > ditaly_pasta.campaign_metric.id]
  projected_change decimal(12,2) [not null, default: 0]
  actual_change decimal(12,2) [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.campaign_metric_variable {
  id integer [pk, increment]
  platform integer [not null, ref: > ditaly_pasta.marketing_platform.id]
  metric_type integer [not null, ref: > ditaly_pasta.campaign_metric_type.id]
  is_required boolean [not null, default: 1]
  default_projection decimal(12,2) [null]
  metric_order integer [not null, default: 1]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}


Table ditaly_pasta.marketing_platform {
  id integer [pk, increment]
  platform varchar(50) [not null, unique]
  description text [null]
  icon varchar(50) [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]
}

Table ditaly_pasta.campaign_stakeholder {
  id integer [pk, increment]
  campaign char(36) [not null, ref: > ditaly_pasta.marketing_campaign.code]
  stakeholder integer [not null, ref: > ditaly_pasta.stakeholder.id]
  role varchar(100) [null]
  notify boolean [not null, default: 0]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  created_by char(36) [not null, ref: > sbm_business.user.code]

Indexes {
    (campaign, stakeholder) [unique]
  }
}


// END marketing & campaign


