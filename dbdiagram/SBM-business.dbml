  updated_by char(36) [null, ref: > sbm_business.user.code]
  deleted_by char(36) [null, ref: > sbm_business.user.code]
}

Table sbm_business.permission_type {
  id integer [pk, increment]
  type varchar(50) [not null]
  description text [not null]
  is_deleted boolean [null]
  is_confirmed boolean [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  confirmed_at datetime [null]
  deleted_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  confirmed_by char(36) [null, ref: > sbm_business.user.code]
