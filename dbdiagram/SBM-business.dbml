}

Table sbm_business.calculation_concept {
  id integer [pk, increment]
  code uuid [not null, unique, default: `gen_random_uuid()`]
  field_name varchar(50) [not null, unique] // net_amount, gross_amount, iva_amount, etc
  description text [null]
  data_type int [not null, ref: > sbm_business.data_type.id]
  is_active boolean [not null, default: true]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  updated_by char(36) [null, ref: > sbm_business.user.code]
}


Table ditaly_pasta.module_calculation_detail {
