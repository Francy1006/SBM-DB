// START SBM configuration tables
Table sbm_business.franchise {
  id integer [pk, increment]
  code char(36) [null, unique, note: 'UUID() REQUIRES TRIGGER']
  franchise varchar(50) [not null]
  description text [not null]
  state integer [not null, ref: > sbm_business.franchise_state.id]
}

Table sbm_business.franchise_state {
  id integer [pk, increment]
  state varchar(50) [not null]
  description text [not null]
}

Table ditaly_pasta.franchise_configuration {
  id integer [pk, increment]
  code char(36) [null, unique, note: 'UUID() REQUIRES TRIGGER']
  configuration varchar(50) [not null]
  franchise char(36) [not null, ref: > sbm_business.franchise.code]
  is_deleted boolean [null]
  is_confirmed boolean [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  confirmed_at datetime [null]
  deleted_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  confirmed_by char(36) [null, ref: > sbm_business.user.code]
  updated_by char(36) [null, ref: > sbm_business.user.code]
  deleted_by char(36) [null, ref: > sbm_business.user.code]
}

Table sbm_business.franchise_configuration_type {
  id integer [pk, increment]
  configuration_type  varchar(50) [not null]
  description text [not null]  
}

Table ditaly_pasta.franchise_configuration_detail {
  id integer [pk, increment]
  code char(36) [null, unique, note: 'UUID() REQUIRES TRIGGER']
  detail varchar(50) [not null]
  description text [not null]
  type integer [not null, ref: > sbm_business.franchise_configuration_type.id]
  configuration char(36) [not null, ref: > ditaly_pasta.franchise_configuration.code]
  variable_formula char(36) [null, ref: > sbm_business.variable_formula.code]
  index integer [not null, default: 1]
  var varchar(50) [not null]
  value decimal(10,2) [not null, default: 0]
  is_deleted boolean [null]
  is_confirmed boolean [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  confirmed_at datetime [null]
  deleted_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  confirmed_by char(36) [null, ref: > sbm_business.user.code]
  updated_by char(36) [null, ref: > sbm_business.user.code]
  deleted_by char(36) [null, ref: > sbm_business.user.code]

  Indexes {
    (id, type) [pk]
  }
}

Table sbm_business.formula_type {
  id integer [pk, increment]
  type varchar(50) [not null, unique]
  description text
}


// END SBM configuration tables

