  }
}





Table sbm_business.fiscal_formula {
  id char(36) [pk, note: 'UUID() REQUIRES TRIGGER']
  formula varchar(50) [not null]
  formula_template text [not null]
  is_deleted boolean [null]
  is_confirmed boolean [null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [null]
  confirmed_at datetime [null]
  deleted_at datetime [null]
  created_by char(36) [not null, ref: > sbm_business.user.code]
  confirmed_by char(36) [null, ref: > sbm_business.user.code]
  updated_by char(36) [null, ref: > sbm_business.user.code]
  deleted_by char(36) [null, ref: > sbm_business.user.code]
}


// END price & sales  tables 


// START accounting tables
Table accounting_account {
  id integer [pk, increment]
  code varchar(20) [not null, unique]
  name varchar(100) [not null]
  type varchar(50) [not null] // ACTIVO, PASIVO, INGRESO, GASTO, etc.
  parent_id integer [ref: > accounting_account.id]
  description text
}

Table accounting_journal {
  id integer [pk, increment]
  name varchar(100) [not null]
  description text
  is_active boolean [not null, default: true]
}

Table accounting_period {
  id integer [pk, increment]
  name varchar(50) [not null]
  year integer [not null]
  start_date date [not null]
  end_date date [not null]
  is_closed boolean [default: false]
}

Table accounting_transaction {
  id integer [pk, increment]
  journal integer [not null, ref: > accounting_journal.id]
  reference varchar(100)
  date date [not null]
  description text
  created_by char(36) [not null, ref: > sbm_business.user.code]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table accounting_entry {
  id integer [pk, increment]
  transaction integer [not null, ref: > accounting_transaction.id]
  account integer [not null, ref: > accounting_account.id]
  amount decimal(12,2) [not null]
  is_debit boolean [not null]
  description text
}

Table accounting_closure {
  id integer [pk, increment]
  period integer [not null, ref: > accounting_period.id]
  closed_by char(36) [not null, ref: > sbm_business.user.code]
  closed_at datetime [default: `CURRENT_TIMESTAMP`]
  notes text
}

Table accounting_tax_report {
  id integer [pk, increment]
  period integer [not null, ref: > accounting_period.id]
  type varchar(50) [not null] // IVA, RETENCION, etc.
  total_amount decimal(12,2) [not null]
  submitted boolean [default: false]
  submitted_at datetime
}

Table accounting_invoice_link {
  id integer [pk, increment]
  invoice_id char(36) [not null] // ref to invoice in finance
  transaction integer [not null, ref: > accounting_transaction.id]
}

Table accounting_fiscal_directive_link {
  id integer [pk, increment]
  directive char(36) [not null, ref: > sbm_business.fiscal_directive.code]
  entry integer [not null, ref: > accounting_entry.id]
}
// END accounting tables

// accounting_account: Plan de cuentas contables (activo, pasivo, ingreso, gasto).

// accounting_journal: Libros contables (ventas, compras, caja).

// accounting_period: Periodos contables (anuales, mensuales).

// accounting_transaction: Transacciones contables (agrupa asientos).

// accounting_entry: Asientos contables (débito/crédito).

// accounting_closure: Cierre de periodo contable.

// accounting_tax_report: Reportes fiscales por periodo (IVA, retención).

// accounting_invoice_link: Vínculo factura ↔ transacción.

// accounting_fiscal_directive_link: Vínculo directiva fiscal ↔ asiento.